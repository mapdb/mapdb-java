equals ::= [
    "boolean": "operatorEquals",
    "byte": "operatorEquals",
    "short": "operatorEquals",
    "char": "operatorEquals",
    "int": "operatorEquals",
    "long": "operatorEquals",
    "float": "floatEquals",
    "double": "doubleEquals",
    default: "no matching equals"
]

operatorEquals(left, right) ::= <<
    <left> == <right>
>>

doubleEquals(left, right) ::= <<
    Double.doubleToRawLongBits(<left>) == Double.doubleToRawLongBits(<right>)
>>

floatEquals(left, right) ::= <<
    Float.floatToRawIntBits(<left>) == Float.floatToRawIntBits(<right>)
>>

notEquals ::= [
    "boolean": "operatorNotEquals",
    "byte": "operatorNotEquals",
    "short": "operatorNotEquals",
    "char": "operatorNotEquals",
    "int": "operatorNotEquals",
    "long": "operatorNotEquals",
    "float": "floatNotEquals",
    "double": "doubleNotEquals",
    default: "no matching not equals"
]

operatorNotEquals(left, right) ::= <<
    <left> != <right>
>>

doubleNotEquals(left, right) ::= <<
    Double.doubleToRawLongBits(<left>) != Double.doubleToRawLongBits(<right>)
>>

floatNotEquals(left, right) ::= <<
    Float.floatToRawIntBits(<left>) != Float.floatToRawIntBits(<right>)
>>

lessThan ::= [
    "byte": "operatorLessThan",
    "short": "operatorLessThan",
    "char": "operatorLessThan",
    "int": "operatorLessThan",
    "long": "operatorLessThan",
    "float": "floatLessThan",
    "double": "doubleLessThan",
    default: "no matching less than"
]

operatorLessThan(left, right) ::= <<
    <left> \< <right>
>>

doubleLessThan(left, right) ::= <<
    org.mapdb.collections.impl.utility.FloatTotalOrder.totalCompare(<left>, <right>) \< 0
>>

floatLessThan(left, right) ::= <<
    org.mapdb.collections.impl.utility.FloatTotalOrder.totalCompare(<left>, <right>) \< 0
>>

greaterThanOrEquals ::= [
    "byte": "operatorGreaterThanOrEquals",
    "short": "operatorGreaterThanOrEquals",
    "char": "operatorGreaterThanOrEquals",
    "int": "operatorGreaterThanOrEquals",
    "long": "operatorGreaterThanOrEquals",
    "float": "floatGreaterThanOrEquals",
    "double": "doubleGreaterThanOrEquals",
    default: "no matching greater than or equals"
]

operatorGreaterThanOrEquals(left, right) ::= <<
    <left> >= <right>
>>

doubleGreaterThanOrEquals(left, right) ::= <<
    org.mapdb.collections.impl.utility.FloatTotalOrder.totalCompare(<left>, <right>) >= 0
>>

floatGreaterThanOrEquals(left, right) ::= <<
    org.mapdb.collections.impl.utility.FloatTotalOrder.totalCompare(<left>, <right>) >= 0
>>

lessThanOrEquals ::= [
    "byte": "operatorLessThanOrEquals",
    "short": "operatorLessThanOrEquals",
    "char": "operatorLessThanOrEquals",
    "int": "operatorLessThanOrEquals",
    "long": "operatorLessThanOrEquals",
    "float": "floatLessThanOrEquals",
    "double": "doubleLessThanOrEquals",
    default: "no matching less than or equals"
]

operatorLessThanOrEquals(left, right) ::= <<
    <left> \<= <right>
>>

doubleLessThanOrEquals(left, right) ::= <<
    org.mapdb.collections.impl.utility.FloatTotalOrder.totalCompare(<left>, <right>) \<= 0
>>

floatLessThanOrEquals(left, right) ::= <<
    org.mapdb.collections.impl.utility.FloatTotalOrder.totalCompare(<left>, <right>) \<= 0
>>

sortArray ::= [
    "float": "totalOrderSortArray",
    "double": "totalOrderSortArray",
    default: "plainSortArray"
]

plainSortArray(array) ::= <<
Arrays.sort(<array>)
>>

totalOrderSortArray(array) ::= <<
org.mapdb.collections.impl.utility.FloatTotalOrder.sort(<array>)
>>

sortArrayRange ::= [
    "float": "totalOrderSortArrayRange",
    "double": "totalOrderSortArrayRange",
    default: "plainSortArrayRange"
]

plainSortArrayRange(array, from, to) ::= <<
Arrays.sort(<array>, <from>, <to>)
>>

totalOrderSortArrayRange(array, from, to) ::= <<
org.mapdb.collections.impl.utility.FloatTotalOrder.sort(<array>, <from>, <to>)
>>

binarySearchArray ::= [
    "float": "totalOrderBinarySearchArray",
    "double": "totalOrderBinarySearchArray",
    default: "plainBinarySearchArray"
]

plainBinarySearchArray(array, value) ::= <<
Arrays.binarySearch(<array>, <value>)
>>

totalOrderBinarySearchArray(array, value) ::= <<
org.mapdb.collections.impl.utility.FloatTotalOrder.binarySearch(<array>, <value>)
>>

binarySearchArrayRange ::= [
    "float": "totalOrderBinarySearchArrayRange",
    "double": "totalOrderBinarySearchArrayRange",
    default: "plainBinarySearchArrayRange"
]

plainBinarySearchArrayRange(array, from, to, value) ::= <<
Arrays.binarySearch(<array>, <from>, <to>, <value>)
>>

totalOrderBinarySearchArrayRange(array, from, to, value) ::= <<
org.mapdb.collections.impl.utility.FloatTotalOrder.binarySearch(<array>, <from>, <to>, <value>)
>>
